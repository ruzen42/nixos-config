font=IBM Plex Mono 10
width=350
height=150
margin=20
padding=15
border-size=2
border-radius=4
sort=-time
layer=top
anchor=top-right

background-color=#2d353b
text-color=#d3c6aa
border-color=#475258
progress-color=source #343f44

[urgency=low]
background-color=#2d353b
text-color=#859289
border-color=#475258
default-timeout=5000

[urgency=normal]
background-color=#2d353b
text-color=#d3c6aa
border-color=#7a8478
default-timeout=10000

[urgency=high]
background-color=#2d353b
text-color=#e67e80
border-color=#e67e80
default-timeout=0

